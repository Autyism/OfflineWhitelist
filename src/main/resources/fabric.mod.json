{
	"schemaVersion": 1,
	"id": "offlinewhitelist",
	"version": "${version}",
	"name": "Offline Whitelist",
	"description": "On servers with online-mode=false, /whitelist add and /whitelist remove use the offline UUID of exactly the name you type instead of looking it up at Mojang, so whitelisted players can actually join. Online-mode servers are not affected.",
	"authors": [
		"Autyism"
	],
	"contact": {
		"homepage": "https://github.com/Autyism/OfflineWhitelist",
		"sources": "https://github.com/Autyism/OfflineWhitelist",
		"issues": "https://github.com/Autyism/OfflineWhitelist/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/offlinewhitelist/icon.png",
	"environment": "server",
	"entrypoints": {
		"server": [
			"io.github.autyism.offlinewhitelist.OfflineWhitelist"
		]
	},
	"mixins": [
		"offlinewhitelist.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.0",
		"minecraft": "1.21.11",
		"java": ">=21",
		"fabric-command-api-v2": "*"
	}
}
