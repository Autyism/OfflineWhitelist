{
	"schemaVersion": 1,
	"id": "offlinewhitelist",
	"version": "${version}",
	"name": "Offline Whitelist",
	"description": "On an offline-mode server, /whitelist add and /whitelist remove use the offline UUID of the name you type instead of looking it up at Mojang.",
	"authors": [
		"Autyi6969"
	],
	"license": "GPL-3.0",
	"environment": "server",
	"entrypoints": {
		"server": ["io.github.autyi6969.offlinewhitelist.OfflineWhitelist"]
	},
	"mixins": [
		"offlinewhitelist.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.0",
		"minecraft": "1.21.11",
		"java": ">=21",
		"fabric-command-api-v2": "*"
	}
}
